// Classroom Roster App - Full Schema
// Designed multi-tenant-ready (Teacher -> Classroom -> Student) even though
// it's single-user today, so adding more teachers later doesn't require a rebuild.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- CORE: Teacher / Classroom / Student ----------

model Teacher {
  id                String      @id @default(cuid())
  name              String
  email             String      @unique
  passwordHash      String
  createdAt         DateTime    @default(now())
  classrooms        Classroom[]
  // Which classroom is "active" right now - lets a teacher have more than
  // one (e.g. two sections, or last year's archived one kept around) and
  // pick which one the rest of the app operates on.
  activeClassroomId String?
  activeClassroom   Classroom?  @relation("ActiveClassroom", fields: [activeClassroomId], references: [id], onDelete: SetNull)
  resetTokens       PasswordResetToken[]
  scheduleBlocks    ScheduleBlock[]
  // Nullable so existing pre-Principal-system Teacher accounts keep working
  // unassigned - only newly-provisioned Teachers are required to have one.
  schoolId          String?
  school            School?     @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  principalId       String?
  principal         Principal?  @relation(fields: [principalId], references: [id], onDelete: SetNull)
  // Only the Principal can change a Teacher's name/email - the Teacher can
  // only change their own password. Set true when a Principal generates a
  // random password for a newly-added Teacher, so the app can nudge them to
  // pick their own on first login; cleared once they do.
  mustChangePassword Boolean    @default(false)
}

// A school, owned by Anthropic's customer (the Principal) who runs it. The
// Admin role only ever sees School name + which Principal(s) run it - never
// any Teacher, classroom, or student data underneath.
model School {
  id         String      @id @default(cuid())
  name       String      @unique
  createdAt  DateTime    @default(now())
  principals Principal[]
  teachers   Teacher[]
  calendarEvents CalendarEvent[]
}

// Sees and manages everything at their one School - adds Teachers (who then
// run their own classrooms independently), can edit a Teacher's name/email
// (the Teacher themselves cannot). Does NOT see other Schools.
model Principal {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  teachers     Teacher[]
}

// Sees only the list of Schools and Principals (name/email/school) - never
// any Teacher, classroom, or student data. Created directly in the database
// (no self-serve signup), since it's the root of trust for the whole app.
model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// A teacher's daily bell schedule - deliberately scoped to the TEACHER, not
// a single Classroom, since the whole point is one unified view of the day
// across every Period/class she teaches (each of which is its own Classroom
// row under the Period system). Applies every school day; no per-weekday
// variation for now.
model ScheduleBlock {
  id              String     @id @default(cuid())
  teacherId       String
  teacher         Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // Which Period/class this block is, if any - null for blocks that aren't
  // tied to a specific class (lunch, recess, announcements, etc).
  classroomId     String?
  classroom       Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  // Which Period (Section) within that classroom, if the block is specific
  // to one - null means "the whole classroom" for this block.
  sectionId       String?
  section         Section?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  label           String
  startTime       String // "HH:MM", 24-hour
  endTime         String // "HH:MM", 24-hour
  // Whether HER students are physically in her room for this block - false
  // for specials/lunch/recess/anything where they're elsewhere.
  studentsInClass Boolean    @default(true)
  createdAt       DateTime   @default(now())
}

model Classroom {
  id         String    @id @default(cuid())
  teacherId  String
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name       String
  schoolName String?
  schoolYear String
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())

  // The school year's overall bounds - set once, then holidays/teacher work
  // days/half days get layered on top. Any weekday in between that isn't
  // otherwise flagged is implicitly a regular student day.
  firstDayOfSchool DateTime?
  lastDayOfSchool  DateTime?

  // Legacy free-text newsletter field - replaced by the Newsletter/
  // NewsletterBlock block-based system below. Left in place (not deleted)
  // so no data is lost; no page reads or writes this anymore.
  newsletterContent String?

  // Canvas bounds for the Seating Layout editor (how big a grid the teacher
  // can place seats within) - not the seat count itself, that's SeatSlot.
  seatingRows Int @default(8)
  seatingCols Int @default(10)

  students       Student[]
  subjects       Subject[]
  events         Event[]
  assignments    Assignment[]
  skillSubjects  SkillSubject[]
  seatSlots      SeatSlot[]
  supportTypes   SupportType[]
  gradeCategories GradeCategory[]
  pacingUnits     PacingUnit[]
  sections        Section[]
  calendarEvents  CalendarEvent[]
  scheduleBlocks  ScheduleBlock[]
  newsletters         Newsletter[]
  newsletterTemplates NewsletterTemplate[]
  spellingLists       SpellingList[]
  activeForTeachers Teacher[] @relation("ActiveClassroom")
}

// ---------- NEWSLETTER (block-based builder) ----------
// Replaces the old single free-text field. A classroom always has exactly
// one "draft" Newsletter at a time (the one the teacher is currently
// building up over the week) plus zero or more "published" ones, which are
// a frozen historical record created by the Publish action - see
// src/lib/newsletter.ts for the render/publish logic. Weekly Report reads
// the current draft's rendered text live (no separate copy needed there).
model Newsletter {
  id            String    @id @default(cuid())
  classroomId   String
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  status        String    @default("draft") // "draft" | "published"
  weekOf        DateTime? // set on publish - the Monday of the week this issue covers
  publishedAt   DateTime?
  // Editable hero banner text - null falls back to a computed default
  // ("{Classroom name}'s Newsletter" / "Week of {today}") so nothing looks
  // broken before she's customized it.
  bannerTitle    String?
  bannerSubtitle String?
  // The real date this newsletter's week ends on (she picks the Friday,
  // typically) - drives which SpellingList counts as "next week's words"
  // (see getUpcomingSpellingList) and the "This Week's Events" block,
  // instead of both silently using the server's real "today." Separate
  // from bannerSubtitle, which is just free-text display and doesn't have
  // to be a real date at all.
  weekEndDate    DateTime?
  // Frozen plain-text rendering, captured at publish time so the archive
  // shows exactly what was sent even if e.g. an Events block's underlying
  // event later gets edited or deleted. The live draft is rendered on the
  // fly instead (see src/lib/newsletter.ts) so it always reflects current
  // data while she's still working on it.
  renderedText  String?
  createdAt     DateTime  @default(now())
  blocks        NewsletterBlock[]

  @@index([classroomId, status])
}

model NewsletterBlock {
  id           String     @id @default(cuid())
  newsletterId String
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  // "heading" | "paragraph" | "list" | "divider" | "image" | "events" |
  // "thisWeekEvents" | "spellingWords" | "wordWall" | "readingNow" |
  // "homeLearning" | "spacer"
  type         String
  // Shape depends on type - see src/lib/newsletter.ts for the contract:
  //   heading:       { text }
  //   paragraph:     { text }
  //   list:          { items: string[] }
  //   divider:       {}
  //   image:         { url, caption? } - url is a data: URI from the
  //                  upload endpoint, not a hand-typed link (see
  //                  /api/newsletter/upload-image) - renders as a real
  //                  image in-app/print, but as a plain link in the
  //                  actual parent email (no real outbound email in this
  //                  app - delivery is a mailto: link, which can't carry
  //                  embedded images).
  //   events:        {} - auto-pulls this classroom's upcoming events at
  //                  render time. Any event that's short on chaperones
  //                  gets a QR code shown right under its date within
  //                  this same block - there's no separate "chaperones"
  //                  block type, by design (see getChaperoneShortfalls).
  //   thisWeekEvents: {} - like events, but scoped to the newsletter's
  //                  own weekEndDate window instead of a rolling
  //                  next-10-upcoming.
  //   spellingWords: {} - auto-pulls the upcoming SpellingList.
  //   wordWall:      { words: string[] }
  //   readingNow:    { title, author?, questions: string[] }
  //   homeLearning:  { items: string[] }
  //   spacer:        {} - renders nothing; exists purely to hold
  //                  intentional blank space on the grid so it doesn't
  //                  get silently packed away.
  content      Json
  order        Int
  // Explicit position on the grid - column/row are where the block
  // starts (1-4 for column; row is open-ended, blocks just stack
  // downward), span/height are how many columns/rows it occupies. This
  // used to be CSS auto-placement (grid-auto-flow: dense), which
  // actively fights "leave this cell blank on purpose" by always
  // backfilling gaps - now every block's rectangle is explicit and
  // checked server-side for collisions before saving (see
  // src/lib/newsletterGrid.ts), so two blocks can never overlap and
  // blank space stays exactly where she put it.
  column       Int        @default(1)
  span         Int        @default(2)
  row          Int        @default(1)
  height       Int        @default(1)

  @@index([newsletterId, order])
}

// A reusable starting layout (e.g. "Standard Weekly Format") the teacher
// can save from a draft and re-apply to a future week's draft, rather than
// rebuilding the same block structure from scratch every time.
model NewsletterTemplate {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime  @default(now())
  blocks      NewsletterTemplateBlock[]
}

model NewsletterTemplateBlock {
  id         String             @id @default(cuid())
  templateId String
  template   NewsletterTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  type       String
  content    Json
  order      Int
  column     Int                @default(1)
  span       Int                @default(2)
  row        Int                @default(1)
  height     Int                @default(1)
}

// ---------- SPELLING ----------
// One list per week (`weekOf` is that week's Monday). She uploads the
// words once; everything else - test days, results, the newsletter's
// auto "next week's words" block, and the word bank analytics - is
// derived from this and SpellingResult, so there's a single source of
// truth for "what were this week's words."
model SpellingList {
  id          String   @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  weekOf      DateTime
  createdAt   DateTime @default(now())

  words    SpellingWord[]
  testDays SpellingTestDay[]

  @@index([classroomId, weekOf])
}

model SpellingWord {
  id     String       @id @default(cuid())
  listId String
  list   SpellingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  word   String
  order  Int

  results SpellingResult[]
}

// A single day she actually administers the test. "first" is the normal
// weekly test (every active student, every word on the list); "makeup" is
// the following week's retest, which only ever includes students who
// missed at least one word on their list's "first" day, and only their
// specific missed words - see getMakeupRoster() in src/lib/spelling.ts,
// which computes that dynamically rather than needing its own schema, so
// a student's makeup list always reflects their actual latest miss state.
model SpellingTestDay {
  id        String       @id @default(cuid())
  listId    String
  list      SpellingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  date      DateTime
  type      String       // "first" | "makeup"
  createdAt DateTime     @default(now())

  results SpellingResult[]

  @@index([listId, date])
}

model SpellingResult {
  id        String          @id @default(cuid())
  testDayId String
  testDay   SpellingTestDay @relation(fields: [testDayId], references: [id], onDelete: Cascade)
  wordId    String
  word      SpellingWord    @relation(fields: [wordId], references: [id], onDelete: Cascade)
  studentId String
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  correct   Boolean

  @@unique([testDayId, wordId, studentId])
  @@index([studentId])
}

// A lighter sub-grouping *within* one classroom (e.g. "Group A" / "Group B",
// or a reading group) - distinct from the multi-classroom/Period system
// above, which is for genuinely separate classes. Sections share all
// classroom-level settings (subjects, grading weights, seating layout, etc)
// and are just used to filter which students show up on a given page.
model Section {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  students       Student[]
  assignments    Assignment[] @relation("AssignmentSections")
  scheduleBlocks ScheduleBlock[]
  pacingDayStatuses PacingUnitDayPeriod[]
  pacingOffsets PeriodPacingOffset[]
  periodExtraDays PeriodExtraDay[]
  events Event[] @relation("EventSections")

  @@unique([classroomId, name])
}

// School-year-wide calendar entries layered on top of the classroom's
// firstDayOfSchool/lastDayOfSchool bounds: full days off (no school for
// anyone), teacher work days (school for staff, but not students - also
// excluded from the Pacing Guide's instructional day count, same as a
// holiday), half days, and general "dates to remember" (field trips,
// picture day, etc - doesn't affect pacing at all). Feeds the Pacing
// Guide's "Dates to Remember" (auto-pulled for whatever falls inside a
// unit's date range) and grays out non-instructional days in the unit's
// week-by-week lesson tables.
model CalendarEvent {
  id          String    @id @default(cuid())
  // Exactly one of classroomId/schoolId is set. classroomId = a Teacher's
  // own local entry (only affects their classroom). schoolId = a Principal-
  // managed entry that applies to every classroom at that School - Teachers
  // see these but can't edit or delete them.
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  startDate   DateTime
  endDate     DateTime
  type        String    // "holiday" | "teacher_work_day" | "half_day" | "other"
  createdAt   DateTime  @default(now())

  // Set when this entry was auto-created from an Events Tracker item.
  sourceEvent Event?
}

// Self-serve password reset. Since no outbound email service is configured
// yet, the reset link is logged server-side (visible in Railway's deploy
// logs) rather than emailed - still self-serve for the account owner who has
// dashboard access, without needing a code change each time. Swap this for
// a real email send later by wiring an email provider into the forgot
// -password route.
model PasswordResetToken {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// A single desk position in the room layout. The full set of SeatSlots for a
// classroom IS the layout - designed once via the Layout editor (rows,
// groups/pods, or fully custom placement), with gaps between slots acting as
// walkways automatically (no special "walkway" flag needed - a walkway is
// just wherever no seat exists). The main Seating Chart page only assigns
// students into whichever slots already exist here.
model SeatSlot {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  row         Int
  col         Int
  createdAt   DateTime  @default(now())

  @@unique([classroomId, row, col])
}

model Student {
  id                 String    @id @default(cuid())
  classroomId        String
  classroom          Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  grade              String?
  section            String?
  sectionId          String?
  sectionGroup       Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  dob                DateTime?
  understandingLevel Int?
  photoConsent       Boolean   @default(true)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())

  tags                StudentTag[]
  allergies           Allergy[]
  dietaryRestrictions DietaryRestriction[]
  ieps                IEP[]
  supports            StudentSupport[]
  parents             Parent[]
  behaviorEntries     BehaviorEntry[]
  behaviorNotes       BehaviorNote[]
  attendanceEntries   AttendanceEntry[]
  homeworkEntries     HomeworkEntry[]
  eventStatuses       EventStatus[]
  eventChaperones     EventChaperone[]
  chaperoneInterests  ChaperoneInterest[]
  skillStatuses       StudentSkillStatus[]
  spellingResults     SpellingResult[]
  observations        Observation[]
  praiseNotes         PraiseNote[]
  seatingAssignment   SeatingAssignment?
  parentContactLogs   ParentContactLog[]

  relationshipsFrom Relationship[] @relation("StudentFrom")
  relationshipsTo   Relationship[] @relation("StudentTo")
}

// ---------- TAGS ----------

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  color    String?
  students StudentTag[]
}

model StudentTag {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([studentId, tagId])
}

// ---------- SAFETY: Allergies / Dietary / IEP ----------

model Allergy {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allergen  String
  severity  String
  reaction  String?
  notes     String?
  createdAt DateTime @default(now())
}

model DietaryRestriction {
  id          String  @id @default(cuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  restriction String
  notes       String?
}

model IEP {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           String
  accommodations String
  serviceMinutes String?
  goals          String?
  caseManager    String?
  reviewDate     DateTime?
  subSafeSummary String?
  createdAt      DateTime  @default(now())
}

// ---------- IEP/504 STRUCTURED SUPPORTS ----------
// Separate from the free-text IEP model above: a checkbox+dropdown system
// for specific support categories (Para Support, Classification, Personal
// Supports, Behavior Supports, or any custom ones the teacher adds). Some
// support types have a dropdown of options (e.g. Classification -> SLD,
// Autism, ADHD...); types with no options defined are just a plain checkbox.

model SupportType {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  options         SupportOption[]
  studentSupports StudentSupport[]

  @@unique([classroomId, name])
}

model SupportOption {
  id            String      @id @default(cuid())
  supportTypeId String
  supportType   SupportType @relation(fields: [supportTypeId], references: [id], onDelete: Cascade)
  label         String
  order         Int         @default(0)

  studentSupports StudentSupport[]
}

model StudentSupport {
  id               String         @id @default(cuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  supportTypeId    String
  supportType      SupportType    @relation(fields: [supportTypeId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   SupportOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime       @default(now())

  @@unique([studentId, supportTypeId])
}

// ---------- PARENTS ----------

model Parent {
  id                 String  @id @default(cuid())
  studentId          String
  student            Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name               String
  relationship       String
  phone              String?
  email              String?
  preferredContact   String?
  isEmergencyContact Boolean @default(false)
  notes              String?
}

// ---------- SOCIAL DYNAMICS ----------

model Relationship {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation("StudentFrom", fields: [studentId], references: [id], onDelete: Cascade)
  relatedStudentId String
  relatedStudent   Student  @relation("StudentTo", fields: [relatedStudentId], references: [id], onDelete: Cascade)
  type             String
  notes            String?
  createdAt        DateTime @default(now())

  @@unique([studentId, relatedStudentId, type])
}

// ---------- SUBJECTS (custom, teacher-defined) ----------

model Subject {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  icon        String?
  order       Int

  behaviorEntries BehaviorEntry[]
  behaviorNotes   BehaviorNote[]
}

// ---------- BEHAVIOR LOG ----------

model BehaviorEntry {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date          DateTime
  calmBody      Boolean  @default(false)
  listeningEars Boolean  @default(false)
  kindWords     Boolean  @default(false)
  stayInArea    Boolean  @default(false)
  finishedWork  Boolean  @default(false)
  none          Boolean  @default(false)
  rating        String?
  comment       String?
  createdAt     DateTime @default(now())

  @@unique([studentId, subjectId, date])
}

// ---------- BEHAVIOR NOTES (replaces the daily rubric above as the primary
// behavior-tracking workflow) ----------
//
// A single dated incident - good or bad - rather than a per-subject daily
// rating. Optionally tagged with which class period it happened during.
// "Called about it" isn't a separate flag: it's whether a ParentContactLog
// entry is linked (contactLogId) - logging the call and marking the note as
// handled are the same action, so there's only ever one source of truth for
// whether/when/how a call happened.
model BehaviorNote {
  id           String            @id @default(cuid())
  studentId    String
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime
  type         String // "good" | "bad"
  tag          String // short label, e.g. "Kind to a classmate" / "Talking out of turn"
  note         String?
  subjectId    String?
  subject      Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  contactLogId String?           @unique
  contactLog   ParentContactLog? @relation(fields: [contactLogId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
}

// ---------- ATTENDANCE ----------

model AttendanceEntry {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String
  notes     String?

  @@unique([studentId, date])
}

// ---------- HOMEWORK (assignment-based) ----------
// A teacher creates one Assignment, which auto-creates a "missing" entry for
// every student. Clicking into the assignment shows the roster and lets the
// teacher tag each student's status - upserting (never duplicating) per
// (assignment, student) pair.

model Assignment {
  id           String     @id @default(cuid())
  classroomId  String
  classroom    Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  skillSubjectId String?
  skillSubject SkillSubject? @relation(fields: [skillSubjectId], references: [id], onDelete: SetNull)
  gradeCategoryId String?
  gradeCategory   GradeCategory? @relation(fields: [gradeCategoryId], references: [id], onDelete: SetNull)
  name         String
  assignedDate DateTime
  dueDate      DateTime?
  gradingType  String     @default("completion") // "completion" (Complete/Incomplete) or "points" (score out of maxPoints)
  maxPoints    Int?       // only used when gradingType = "points"
  // Optional: knock this many percentage points off a student's grade for
  // each day their submission is late (based on submittedAt vs dueDate).
  // Null/0 = no penalty. Applies uniformly to both grading types, since
  // both ultimately reduce to a 0-100 percent grade.
  latePenaltyPercentPerDay Int?
  // Draft workflow: an assignment can be created ahead of time (entries
  // exist so grading/prep can happen) without yet being visible on the
  // Gradebook or Student Profile - only flips to true once actually handed
  // out to students.
  handedOut    Boolean    @default(true)
  // Optional tag linking this assignment to a spot in the Pacing Guide.
  pacingUnitId  String?
  pacingUnit    PacingUnit?  @relation(fields: [pacingUnitId], references: [id], onDelete: SetNull)
  pacingTopicId String?
  pacingTopic   UnitTopic?   @relation(fields: [pacingTopicId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  entries  HomeworkEntry[]
  // Which Sections (subgroups) this assignment was given to. Empty = the
  // whole classroom (all students, no subgroup restriction) - matches the
  // convention used elsewhere that "no section" means "everyone".
  sections Section[]       @relation("AssignmentSections")
}

// Weighted grading categories (e.g. Classwork 20%, Homework 30%, Tests 50%).
// Teacher-configurable per classroom from the Gradebook page. Weights don't
// have to sum to exactly 100 - the overall grade calculation normalizes
// against whichever categories actually have graded work in them.
model GradeCategory {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  weight      Int       @default(0) // percentage, 0-100
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  assignments Assignment[]

  @@unique([classroomId, name])
}

model HomeworkEntry {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  status       String     @default("missing") // SUBMISSION status only: "missing" / "handed_in"
  submittedAt  DateTime?  // set when status becomes "handed_in" - used to flag late submissions
  gradeStatus  String?    // "complete" / "incomplete" - used when assignment.gradingType = "completion"
  gradeScore   Int?       // score out of assignment.maxPoints - used when assignment.gradingType = "points"
  note         String?
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, studentId])
}

// ---------- EVENTS (field trips, etc.) ----------

model Event {
  id              String    @id @default(cuid())
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name            String
  date            DateTime
  dueDate         DateTime?
  requiresPayment Boolean   @default(false)
  // Dollar amount owed per student, when requiresPayment is true.
  paymentAmount   Float?
  description     String?
  // Free-text teacher notes - private, never shown to parents.
  notes           String?
  // How many chaperones this event needs - compared against confirmed
  // EventChaperone rows to flag a shortfall in the weekly report.
  chaperonesNeeded Int?
  createdAt       DateTime  @default(now())

  // Auto-synced into the School Calendar as a "Reminder" entry (see
  // /api/events) so the Pacing Guide's "Dates to Remember" and the calendar
  // itself both show when students will be out on this event/field trip -
  // it's reminder-only (doesn't skip instructional days), since an event
  // doesn't necessarily mean the whole class misses the whole day.
  calendarEventId String?        @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)

  statuses EventStatus[]
  chaperones EventChaperone[]
  chaperoneInterests ChaperoneInterest[]
  // Which Periods (Sections) this event applies to - empty means the whole
  // classroom, same "no tag means everyone" convention used for Assignments.
  sections Section[] @relation("EventSections")
}

model EventStatus {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slipStatus    String   @default("missing")
  paymentStatus String?
  // "Confirmed coming" - a separate flag from slip/payment, since a slip
  // being turned in doesn't necessarily mean the teacher's actually
  // confirmed the student is attending.
  confirmed     Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@unique([eventId, studentId])
}

// A parent chaperone volunteer for an Event, tied to their student - the
// @@unique below is what makes "don't attach if that kid's parents already
// signed up" automatic: one chaperone slot per student per event, not per
// parent, so a family can't (accidentally or otherwise) end up with two
// separate signups for the same kid.
model EventChaperone {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentName   String
  relationship String   // "Mom" | "Dad" | "Guardian" | other free text
  confirmed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([eventId, studentId])
}

// A parent expressing INTEREST in chaperoning, submitted through a public
// link (no login) - deliberately separate from EventChaperone, since this
// is NOT a direct signup. The teacher reviews these, emails the parent
// directly with details, and only then manually adds them as a real
// EventChaperone. No unique constraint here - both parents of the same
// student might reasonably express interest separately, and the teacher is
// reviewing/deduping by hand anyway.
model ChaperoneInterest {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Privacy fix: the public form never sees or picks from the class
  // roster - a parent types their child's name as free text instead.
  // studentId stays nullable and is only ever set later, manually, by the
  // teacher if she chooses to link this interest row to a real student
  // record after following up.
  studentName  String
  studentId    String?
  student      Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  parentName   String
  contactInfo  String   // email or phone, whatever the parent gave
  note         String?
  createdAt    DateTime @default(now())
}

// ---------- UNIFIED SKILLS SYSTEM ----------
// A classroom picks which subjects it teaches (SkillSubject - e.g. Math,
// Reading, Writing, Science; generic defaults + teacher can add custom ones
// from the Profile page). Each subject has its own list of Skills (optionally
// grouped by category, e.g. Math -> "multiplication"/"7s"), and each student
// gets a mastery status per skill. One shared table/tab in the UI, filtered
// by whichever subject is selected at the top.

model SkillSubject {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  order       Int       @default(0)
  isActive    Boolean   @default(true) // toggled from Profile's subject picker
  createdAt   DateTime  @default(now())

  skills Skill[]
  assignments Assignment[]

  @@unique([classroomId, name])
}

model Skill {
  id             String       @id @default(cuid())
  skillSubjectId String
  skillSubject   SkillSubject @relation(fields: [skillSubjectId], references: [id], onDelete: Cascade)
  category       String? // optional sub-grouping within the subject, e.g. "multiplication"
  skillName      String
  order          Int          @default(0)

  statuses StudentSkillStatus[]
}

model StudentSkillStatus {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  status    String   @default("0") // 0-5 rating scale: 0 = not started, 5 = fully mastered
  updatedAt DateTime @updatedAt

  @@unique([studentId, skillId])
}

// ---------- PARENT CONTACT LOG ----------
// Tracks every time the teacher contacts a parent: why (behavior concern,
// skill update, positive note, or something else), a comment, and the date.

// ---------- PACING GUIDE (curriculum units) ----------
// A Unit is a chunk of curriculum with a date range (e.g. "Unit 1 - Ancient
// Middle Ages", 8/10-9/11). Creating/resizing a unit auto-generates a
// PacingUnitDay row for every weekday in that range, which the teacher can
// fill in with daily lesson plan details. Units can be freely added or
// removed ("add or subtract units").

model PacingUnit {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  order       Int       @default(0)
  startDate   DateTime
  endDate     DateTime
  standards   String? // free text, e.g. "6.1A, 6.2B, 6.3C"
  topics      String? // legacy free text, one per line - superseded by UnitTopic below, kept for back-compat
  summatives  String? // legacy free text - superseded by UnitSummative below, kept for back-compat
  datesToRemember String? // legacy free text - superseded by auto-pull from CalendarEvent, kept for back-compat
  createdAt   DateTime  @default(now())

  days           PacingUnitDay[]
  unitSummatives UnitSummative[]
  unitTopics     UnitTopic[]
  assignments    Assignment[]
  periodOffsets  PeriodPacingOffset[]
  periodExtraDays PeriodExtraDay[]
}

// A single summative assessment tied to a unit - Title + Date, added/removed
// via a small popup rather than a free-text box.
model UnitSummative {
  id        String     @id @default(cuid())
  unitId    String
  unit      PacingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  order     Int        @default(0)
  createdAt DateTime   @default(now())
}

// A block of curriculum within a unit (e.g. "Fractions", 4 days). Adding one
// auto-fills that many consecutive day-rows in the week tables, continuing
// sequentially from wherever the previous topic left off (the first topic
// starts at Day 1 of the unit).
model UnitTopic {
  id             String     @id @default(cuid())
  unitId         String
  unit           PacingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name           String
  days           Int // how many instructional days this topic spans
  learningTarget String?
  standards      String?
  support        String?
  order          Int        @default(0)
  createdAt      DateTime   @default(now())

  unitDays    PacingUnitDay[]
  assignments Assignment[]
}

model PacingUnitDay {
  id               String     @id @default(cuid())
  pacingUnitId     String
  pacingUnit       PacingUnit @relation(fields: [pacingUnitId], references: [id], onDelete: Cascade)
  // Sequential position within the unit (1-based). This, not the date, is
  // the source of truth for ordering/topic auto-fill/day insertion - the
  // date is (re)computed from it whenever the schedule changes.
  dayNumber        Int        @default(0)
  date             DateTime
  topicId          String?
  unitTopic        UnitTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topic            String?
  learningTarget   String?
  standards        String?
  supports         String?
  lessonActivities String?
  warmUp           String?
  materialsNeeded  String?
  // "not_started" | "completed" | "half_completed". Marking a day
  // half_completed auto-inserts an extra day right after it (see the
  // pacing-units/days/[dayId]/status route) since the lesson spills over.
  status           String     @default("not_started")
  // true if this row was auto-inserted because a previous day was marked
  // half_completed - lets the UI offer to remove it if it ends up unused.
  isExtraDay       Boolean    @default(false)
  periodStatuses   PacingUnitDayPeriod[]

  @@unique([pacingUnitId, dayNumber])
}

// Per-Period completion status for a shared PacingUnitDay - lets one Period
// run behind (or ahead of) another on the SAME shared day/topic sequence,
// without duplicating the actual lesson content (topic, learning target,
// etc), which stays unit-wide. A day with no row here for a given Section
// is treated as "not_started" for that Period by default - only created
// once a Period's status on that day is actually set to something.
model PacingUnitDayPeriod {
  id               String        @id @default(cuid())
  pacingUnitDayId  String
  pacingUnitDay    PacingUnitDay @relation(fields: [pacingUnitDayId], references: [id], onDelete: Cascade)
  sectionId        String
  section          Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  status           String        @default("not_started") // "not_started" | "completed" | "half_completed"
  updatedAt        DateTime      @updatedAt

  @@unique([pacingUnitDayId, sectionId])
}

// How many extra instructional days a given Period needs beyond the shared
// unit schedule - incremented when that Period (not the whole class) marks
// a day half_completed, mirroring the shared half_completed → extra-day
// behavior but scoped to just that Period instead of inserting a real day
// into the shared PacingUnitDay sequence every other Period would also see.
// Used to compute that Period's own "actually ends" date on the unit list.
model PeriodPacingOffset {
  id           String     @id @default(cuid())
  pacingUnitId String
  pacingUnit   PacingUnit @relation(fields: [pacingUnitId], references: [id], onDelete: Cascade)
  sectionId    String
  section      Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  extraDays    Int        @default(0)
  updatedAt    DateTime   @updatedAt

  @@unique([pacingUnitId, sectionId])
}

// A real, plannable extra day for ONE Period only - created when that
// Period (not the whole class) marks a shared day half_completed, meaning
// its lesson spilled over and it needs one more day than everyone else.
// Deliberately a completely separate table from PacingUnitDay, not a
// sectionId-tagged row within it - PacingUnitDay is read/written by ~15
// different functions that manage the SHARED schedule (topic auto-fill,
// day insertion/shrinking, cross-unit cascades), and none of them are
// scoped to exclude Period-specific rows. Keeping this fully isolated means
// none of that shared logic needs to change or can accidentally touch a
// Period's own day. The week/calendar view merges these in for display only
// when that Period is the active one.
model PeriodExtraDay {
  id               String     @id @default(cuid())
  pacingUnitId     String
  pacingUnit       PacingUnit @relation(fields: [pacingUnitId], references: [id], onDelete: Cascade)
  sectionId        String
  section          Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  // Which real shared day this spilled over from - the extra day inherits
  // its topic/content as a starting point, same as the shared version does.
  spilledFromDayId String?
  date             DateTime
  topic            String?
  learningTarget   String?
  standards        String?
  supports         String?
  lessonActivities String?
  warmUp           String?
  materialsNeeded  String?
  status           String     @default("not_started")
  createdAt        DateTime   @default(now())
}

model ParentContactLog {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  reason    String   // "behavior" / "skill" / "positive" / "other"
  method    String   @default("phone") // "email" / "phone" / "in_person" / "other"
  comment   String?
  followUp  Boolean  @default(false)
  createdAt DateTime @default(now())

  // Set when this call was logged directly from a BehaviorNote's "Log Call"
  // action - the reverse side of BehaviorNote.contactLogId.
  behaviorNote BehaviorNote?
}

// ---------- NOTES: Observations (quick-notes) & Praise ----------

model Observation {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  note      String
  createdAt DateTime @default(now())
}

model PraiseNote {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  note      String
  createdAt DateTime @default(now())
}

// ---------- SEATING CHART ----------

model SeatingAssignment {
  id        String   @id @default(cuid())
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  posX      Int
  posY      Int
  updatedAt DateTime @updatedAt
}
