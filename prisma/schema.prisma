// Classroom Roster App - Full Schema
// Designed multi-tenant-ready (Teacher -> Classroom -> Student) even though
// it's single-user today, so adding more teachers later doesn't require a rebuild.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- CORE: Teacher / Classroom / Student ----------

model Teacher {
  id                String      @id @default(cuid())
  name              String
  email             String      @unique
  passwordHash      String
  createdAt         DateTime    @default(now())
  classrooms        Classroom[]
  // Which classroom is "active" right now - lets a teacher have more than
  // one (e.g. two sections, or last year's archived one kept around) and
  // pick which one the rest of the app operates on.
  activeClassroomId String?
  activeClassroom   Classroom?  @relation("ActiveClassroom", fields: [activeClassroomId], references: [id], onDelete: SetNull)
  resetTokens       PasswordResetToken[]
  scheduleBlocks    ScheduleBlock[]
}

// A teacher's daily bell schedule - deliberately scoped to the TEACHER, not
// a single Classroom, since the whole point is one unified view of the day
// across every Period/class she teaches (each of which is its own Classroom
// row under the Period system). Applies every school day; no per-weekday
// variation for now.
model ScheduleBlock {
  id              String     @id @default(cuid())
  teacherId       String
  teacher         Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // Which Period/class this block is, if any - null for blocks that aren't
  // tied to a specific class (lunch, recess, announcements, etc).
  classroomId     String?
  classroom       Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  label           String
  startTime       String // "HH:MM", 24-hour
  endTime         String // "HH:MM", 24-hour
  // Whether HER students are physically in her room for this block - false
  // for specials/lunch/recess/anything where they're elsewhere.
  studentsInClass Boolean    @default(true)
  createdAt       DateTime   @default(now())
}

model Classroom {
  id         String    @id @default(cuid())
  teacherId  String
  teacher    Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  name       String
  schoolName String?
  schoolYear String
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())

  // The school year's overall bounds - set once, then holidays/teacher work
  // days/half days get layered on top. Any weekday in between that isn't
  // otherwise flagged is implicitly a regular student day.
  firstDayOfSchool DateTime?
  lastDayOfSchool  DateTime?

  // Canvas bounds for the Seating Layout editor (how big a grid the teacher
  // can place seats within) - not the seat count itself, that's SeatSlot.
  seatingRows Int @default(8)
  seatingCols Int @default(10)

  students       Student[]
  subjects       Subject[]
  events         Event[]
  assignments    Assignment[]
  skillSubjects  SkillSubject[]
  seatSlots      SeatSlot[]
  supportTypes   SupportType[]
  gradeCategories GradeCategory[]
  pacingUnits     PacingUnit[]
  sections        Section[]
  calendarEvents  CalendarEvent[]
  scheduleBlocks  ScheduleBlock[]
  activeForTeachers Teacher[] @relation("ActiveClassroom")
}

// A lighter sub-grouping *within* one classroom (e.g. "Group A" / "Group B",
// or a reading group) - distinct from the multi-classroom/Period system
// above, which is for genuinely separate classes. Sections share all
// classroom-level settings (subjects, grading weights, seating layout, etc)
// and are just used to filter which students show up on a given page.
model Section {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  students Student[]

  @@unique([classroomId, name])
}

// School-year-wide calendar entries layered on top of the classroom's
// firstDayOfSchool/lastDayOfSchool bounds: full days off (no school for
// anyone), teacher work days (school for staff, but not students - also
// excluded from the Pacing Guide's instructional day count, same as a
// holiday), half days, and general "dates to remember" (field trips,
// picture day, etc - doesn't affect pacing at all). Feeds the Pacing
// Guide's "Dates to Remember" (auto-pulled for whatever falls inside a
// unit's date range) and grays out non-instructional days in the unit's
// week-by-week lesson tables.
model CalendarEvent {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  startDate   DateTime
  endDate     DateTime
  type        String    // "holiday" | "teacher_work_day" | "half_day" | "other"
  createdAt   DateTime  @default(now())
}

// Self-serve password reset. Since no outbound email service is configured
// yet, the reset link is logged server-side (visible in Railway's deploy
// logs) rather than emailed - still self-serve for the account owner who has
// dashboard access, without needing a code change each time. Swap this for
// a real email send later by wiring an email provider into the forgot
// -password route.
model PasswordResetToken {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// A single desk position in the room layout. The full set of SeatSlots for a
// classroom IS the layout - designed once via the Layout editor (rows,
// groups/pods, or fully custom placement), with gaps between slots acting as
// walkways automatically (no special "walkway" flag needed - a walkway is
// just wherever no seat exists). The main Seating Chart page only assigns
// students into whichever slots already exist here.
model SeatSlot {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  row         Int
  col         Int
  createdAt   DateTime  @default(now())

  @@unique([classroomId, row, col])
}

model Student {
  id                 String    @id @default(cuid())
  classroomId        String
  classroom          Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  grade              String
  section            String?
  sectionId          String?
  sectionGroup       Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  dob                DateTime?
  understandingLevel Int?
  photoConsent       Boolean   @default(true)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())

  tags                StudentTag[]
  allergies           Allergy[]
  dietaryRestrictions DietaryRestriction[]
  ieps                IEP[]
  supports            StudentSupport[]
  parents             Parent[]
  behaviorEntries     BehaviorEntry[]
  behaviorNotes       BehaviorNote[]
  attendanceEntries   AttendanceEntry[]
  homeworkEntries     HomeworkEntry[]
  eventStatuses       EventStatus[]
  skillStatuses       StudentSkillStatus[]
  observations        Observation[]
  praiseNotes         PraiseNote[]
  seatingAssignment   SeatingAssignment?
  parentContactLogs   ParentContactLog[]

  relationshipsFrom Relationship[] @relation("StudentFrom")
  relationshipsTo   Relationship[] @relation("StudentTo")
}

// ---------- TAGS ----------

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  color    String?
  students StudentTag[]
}

model StudentTag {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([studentId, tagId])
}

// ---------- SAFETY: Allergies / Dietary / IEP ----------

model Allergy {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  allergen  String
  severity  String
  reaction  String?
  notes     String?
  createdAt DateTime @default(now())
}

model DietaryRestriction {
  id          String  @id @default(cuid())
  studentId   String
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  restriction String
  notes       String?
}

model IEP {
  id             String    @id @default(cuid())
  studentId      String
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type           String
  accommodations String
  serviceMinutes String?
  goals          String?
  caseManager    String?
  reviewDate     DateTime?
  subSafeSummary String?
  createdAt      DateTime  @default(now())
}

// ---------- IEP/504 STRUCTURED SUPPORTS ----------
// Separate from the free-text IEP model above: a checkbox+dropdown system
// for specific support categories (Para Support, Classification, Personal
// Supports, Behavior Supports, or any custom ones the teacher adds). Some
// support types have a dropdown of options (e.g. Classification -> SLD,
// Autism, ADHD...); types with no options defined are just a plain checkbox.

model SupportType {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  options         SupportOption[]
  studentSupports StudentSupport[]

  @@unique([classroomId, name])
}

model SupportOption {
  id            String      @id @default(cuid())
  supportTypeId String
  supportType   SupportType @relation(fields: [supportTypeId], references: [id], onDelete: Cascade)
  label         String
  order         Int         @default(0)

  studentSupports StudentSupport[]
}

model StudentSupport {
  id               String         @id @default(cuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  supportTypeId    String
  supportType      SupportType    @relation(fields: [supportTypeId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   SupportOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  notes            String?
  createdAt        DateTime       @default(now())

  @@unique([studentId, supportTypeId])
}

// ---------- PARENTS ----------

model Parent {
  id                 String  @id @default(cuid())
  studentId          String
  student            Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name               String
  relationship       String
  phone              String?
  email              String?
  preferredContact   String?
  isEmergencyContact Boolean @default(false)
  notes              String?
}

// ---------- SOCIAL DYNAMICS ----------

model Relationship {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation("StudentFrom", fields: [studentId], references: [id], onDelete: Cascade)
  relatedStudentId String
  relatedStudent   Student  @relation("StudentTo", fields: [relatedStudentId], references: [id], onDelete: Cascade)
  type             String
  notes            String?
  createdAt        DateTime @default(now())

  @@unique([studentId, relatedStudentId, type])
}

// ---------- SUBJECTS (custom, teacher-defined) ----------

model Subject {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  icon        String?
  order       Int

  behaviorEntries BehaviorEntry[]
  behaviorNotes   BehaviorNote[]
}

// ---------- BEHAVIOR LOG ----------

model BehaviorEntry {
  id            String   @id @default(cuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  date          DateTime
  calmBody      Boolean  @default(false)
  listeningEars Boolean  @default(false)
  kindWords     Boolean  @default(false)
  stayInArea    Boolean  @default(false)
  finishedWork  Boolean  @default(false)
  none          Boolean  @default(false)
  rating        String?
  comment       String?
  createdAt     DateTime @default(now())

  @@unique([studentId, subjectId, date])
}

// ---------- BEHAVIOR NOTES (replaces the daily rubric above as the primary
// behavior-tracking workflow) ----------
//
// A single dated incident - good or bad - rather than a per-subject daily
// rating. Optionally tagged with which class period it happened during.
// "Called about it" isn't a separate flag: it's whether a ParentContactLog
// entry is linked (contactLogId) - logging the call and marking the note as
// handled are the same action, so there's only ever one source of truth for
// whether/when/how a call happened.
model BehaviorNote {
  id           String            @id @default(cuid())
  studentId    String
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime
  type         String // "good" | "bad"
  tag          String // short label, e.g. "Kind to a classmate" / "Talking out of turn"
  note         String?
  subjectId    String?
  subject      Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  contactLogId String?           @unique
  contactLog   ParentContactLog? @relation(fields: [contactLogId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
}

// ---------- ATTENDANCE ----------

model AttendanceEntry {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String
  notes     String?

  @@unique([studentId, date])
}

// ---------- HOMEWORK (assignment-based) ----------
// A teacher creates one Assignment, which auto-creates a "missing" entry for
// every student. Clicking into the assignment shows the roster and lets the
// teacher tag each student's status - upserting (never duplicating) per
// (assignment, student) pair.

model Assignment {
  id           String     @id @default(cuid())
  classroomId  String
  classroom    Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  skillSubjectId String?
  skillSubject SkillSubject? @relation(fields: [skillSubjectId], references: [id], onDelete: SetNull)
  gradeCategoryId String?
  gradeCategory   GradeCategory? @relation(fields: [gradeCategoryId], references: [id], onDelete: SetNull)
  name         String
  assignedDate DateTime
  dueDate      DateTime?
  gradingType  String     @default("completion") // "completion" (Complete/Incomplete) or "points" (score out of maxPoints)
  maxPoints    Int?       // only used when gradingType = "points"
  createdAt    DateTime   @default(now())

  entries HomeworkEntry[]
}

// Weighted grading categories (e.g. Classwork 20%, Homework 30%, Tests 50%).
// Teacher-configurable per classroom from the Gradebook page. Weights don't
// have to sum to exactly 100 - the overall grade calculation normalizes
// against whichever categories actually have graded work in them.
model GradeCategory {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  weight      Int       @default(0) // percentage, 0-100
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  assignments Assignment[]

  @@unique([classroomId, name])
}

model HomeworkEntry {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  status       String     @default("missing") // SUBMISSION status only: "missing" / "handed_in"
  submittedAt  DateTime?  // set when status becomes "handed_in" - used to flag late submissions
  gradeStatus  String?    // "complete" / "incomplete" - used when assignment.gradingType = "completion"
  gradeScore   Int?       // score out of assignment.maxPoints - used when assignment.gradingType = "points"
  note         String?
  updatedAt    DateTime   @updatedAt

  @@unique([assignmentId, studentId])
}

// ---------- EVENTS (field trips, etc.) ----------

model Event {
  id              String    @id @default(cuid())
  classroomId     String
  classroom       Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name            String
  date            DateTime
  dueDate         DateTime?
  requiresPayment Boolean   @default(false)
  description     String?
  createdAt       DateTime  @default(now())

  statuses EventStatus[]
}

model EventStatus {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  slipStatus    String   @default("missing")
  paymentStatus String?
  updatedAt     DateTime @updatedAt

  @@unique([eventId, studentId])
}

// ---------- UNIFIED SKILLS SYSTEM ----------
// A classroom picks which subjects it teaches (SkillSubject - e.g. Math,
// Reading, Writing, Science; generic defaults + teacher can add custom ones
// from the Profile page). Each subject has its own list of Skills (optionally
// grouped by category, e.g. Math -> "multiplication"/"7s"), and each student
// gets a mastery status per skill. One shared table/tab in the UI, filtered
// by whichever subject is selected at the top.

model SkillSubject {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  order       Int       @default(0)
  isActive    Boolean   @default(true) // toggled from Profile's subject picker
  createdAt   DateTime  @default(now())

  skills Skill[]
  assignments Assignment[]

  @@unique([classroomId, name])
}

model Skill {
  id             String       @id @default(cuid())
  skillSubjectId String
  skillSubject   SkillSubject @relation(fields: [skillSubjectId], references: [id], onDelete: Cascade)
  category       String? // optional sub-grouping within the subject, e.g. "multiplication"
  skillName      String
  order          Int          @default(0)

  statuses StudentSkillStatus[]
}

model StudentSkillStatus {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  status    String   @default("0") // 0-5 rating scale: 0 = not started, 5 = fully mastered
  updatedAt DateTime @updatedAt

  @@unique([studentId, skillId])
}

// ---------- PARENT CONTACT LOG ----------
// Tracks every time the teacher contacts a parent: why (behavior concern,
// skill update, positive note, or something else), a comment, and the date.

// ---------- PACING GUIDE (curriculum units) ----------
// A Unit is a chunk of curriculum with a date range (e.g. "Unit 1 - Ancient
// Middle Ages", 8/10-9/11). Creating/resizing a unit auto-generates a
// PacingUnitDay row for every weekday in that range, which the teacher can
// fill in with daily lesson plan details. Units can be freely added or
// removed ("add or subtract units").

model PacingUnit {
  id          String    @id @default(cuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  order       Int       @default(0)
  startDate   DateTime
  endDate     DateTime
  standards   String? // free text, e.g. "6.1A, 6.2B, 6.3C"
  topics      String? // legacy free text, one per line - superseded by UnitTopic below, kept for back-compat
  summatives  String? // legacy free text - superseded by UnitSummative below, kept for back-compat
  datesToRemember String? // legacy free text - superseded by auto-pull from CalendarEvent, kept for back-compat
  createdAt   DateTime  @default(now())

  days           PacingUnitDay[]
  unitSummatives UnitSummative[]
  unitTopics     UnitTopic[]
}

// A single summative assessment tied to a unit - Title + Date, added/removed
// via a small popup rather than a free-text box.
model UnitSummative {
  id        String     @id @default(cuid())
  unitId    String
  unit      PacingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  order     Int        @default(0)
  createdAt DateTime   @default(now())
}

// A block of curriculum within a unit (e.g. "Fractions", 4 days). Adding one
// auto-fills that many consecutive day-rows in the week tables, continuing
// sequentially from wherever the previous topic left off (the first topic
// starts at Day 1 of the unit).
model UnitTopic {
  id             String     @id @default(cuid())
  unitId         String
  unit           PacingUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name           String
  days           Int // how many instructional days this topic spans
  learningTarget String?
  standards      String?
  support        String?
  order          Int        @default(0)
  createdAt      DateTime   @default(now())

  unitDays PacingUnitDay[]
}

model PacingUnitDay {
  id               String     @id @default(cuid())
  pacingUnitId     String
  pacingUnit       PacingUnit @relation(fields: [pacingUnitId], references: [id], onDelete: Cascade)
  // Sequential position within the unit (1-based). This, not the date, is
  // the source of truth for ordering/topic auto-fill/day insertion - the
  // date is (re)computed from it whenever the schedule changes.
  dayNumber        Int        @default(0)
  date             DateTime
  topicId          String?
  unitTopic        UnitTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topic            String?
  learningTarget   String?
  standards        String?
  supports         String?
  lessonActivities String?
  warmUp           String?
  materialsNeeded  String?
  // "not_started" | "completed" | "half_completed". Marking a day
  // half_completed auto-inserts an extra day right after it (see the
  // pacing-units/days/[dayId]/status route) since the lesson spills over.
  status           String     @default("not_started")
  // true if this row was auto-inserted because a previous day was marked
  // half_completed - lets the UI offer to remove it if it ends up unused.
  isExtraDay       Boolean    @default(false)

  @@unique([pacingUnitId, dayNumber])
}

model ParentContactLog {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  reason    String   // "behavior" / "skill" / "positive" / "other"
  method    String   @default("phone") // "email" / "phone" / "in_person" / "other"
  comment   String?
  followUp  Boolean  @default(false)
  createdAt DateTime @default(now())

  // Set when this call was logged directly from a BehaviorNote's "Log Call"
  // action - the reverse side of BehaviorNote.contactLogId.
  behaviorNote BehaviorNote?
}

// ---------- NOTES: Observations (quick-notes) & Praise ----------

model Observation {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  note      String
  createdAt DateTime @default(now())
}

model PraiseNote {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  note      String
  createdAt DateTime @default(now())
}

// ---------- SEATING CHART ----------

model SeatingAssignment {
  id        String   @id @default(cuid())
  studentId String   @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  posX      Int
  posY      Int
  updatedAt DateTime @updatedAt
}
